APP_NAME=FatwaRAG
APP_ENV=local
# php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL with pgvector and pg_trgm (dev: the docker compose service on 54329)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=fatwarag
DB_USERNAME=fatwarag
DB_PASSWORD=

# Redis holds the cache, queue, sessions, per-visitor limits and the answer handoff (dev: 63799)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63799

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------------------------
# FatwaRAG
# ---------------------------------------------------------------------------------------------

# The public site (share links, the admin's «Open page»)
SITE_URL=http://localhost:3100
# Shared with the Next.js BFF: requests carrying it are trusted to pass the visitor's IP
BFF_KEY=

# The admin account created by the seeder (/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_URL=   (default: APP_URL/admin)

# AI, all through OpenRouter
OPENROUTER_API_KEY=
# MODEL_SUMMARY=anthropic/claude-sonnet-5.5
# MODEL_TRANSLATION=anthropic/claude-haiku-5.5
# MODEL_RERANK=voyageai/rerank-3

# Turnstile (reports, contact and shares)
TURNSTILE_SECRET_KEY=

# Owner alerts and reports on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Browser Run (Dorar hadith lookups)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The raw harvest store the importers read (default: ../data/raw)
# FATWARAG_RAW_PATH=

# Optional tuning (defaults shown)
# ASK_CACHE_STORE=redis
# CONTENT_CACHE_STORE=
# SEARCH_MAX_RESULTS=5
# SEARCH_MAX_RESULTS_PER_PART=5
# SEARCH_MAX_RESULTS_PARTS=10
# SEARCH_RELEVANCE_FLOOR=0.5
# QUESTION_GATE_TIMEOUT_SECONDS=3
# QUESTION_GATE_WAIT_SECONDS=5
# QUESTION_GATE_CACHE_SECONDS=2592000
# SUMMARY_CLAIMS_JUDGE=true
# SUMMARY_PRUNE=false
# SUMMARY_REASONING=low
# SUMMARY_CONCURRENCY_DRIVER=process
# SUMMARY_MAX_INPUT_TOKENS=150000
# SUMMARY_MAX_OUTPUT_TOKENS=6000
# SUMMARY_REWRITE_BUDGET_SECONDS=25
# SUMMARY_WALL_SECONDS=300
# SUMMARY_HEARTBEAT_SECONDS=5
# SUMMARY_QUEUE_SECONDS=3
# SUMMARY_PER_CLIENT_PER_MINUTE=10
# SUMMARY_MAX_STREAMS_PER_CLIENT=2
# SUMMARY_MAX_PROCESSES=18
# SUMMARY_MAX_PROCESSES_PER_CLIENT=6
# SUMMARY_MAX_SPAWNED=24
# SUMMARY_PROCESS_SLOTS_CONNECTION=default
# SUMMARY_GROUNDING_MIN_COVERAGE=0.7
# SUMMARY_GROUNDING_MIN_SUPPORT_COVERAGE=0.4
# TOPICS_ENRICH_MIN_FATWAS=10

# Octane (FrankenPHP). A small server uses about 6 workers.
# OCTANE_WORKERS=24

# Production only (compose.prod.yaml): host port, raw store on the host
# APP_PORT=8080
# RAW_HOST_PATH=/srv/fatwarag/raw

# Production only: the Cloudflare Tunnel token (compose.prod.yaml)
# CLOUDFLARE_TUNNEL_TOKEN=
